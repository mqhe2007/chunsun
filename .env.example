# 仅供本仓库从源码跑平台（debug 会读根目录 .env）。
# 正式部署走安装向导，不要用这份文件。

DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string

# 对外访问原点（CLI 交叉编译会据此写入默认 API /cli 下载地址）
# PUBLIC_ORIGIN=https://chunsun.example.com
# HOST_BASE_PATH=/

# 浏览器访问口（开发网关 / 生产二进制对外监听）
PORT=11111
# 本地开发：后端监听此口，网关将 /api 反代到此（pnpm dev 会设置）
API_PORT=11112
# 本地开发：官网 / 控制台 Vite（一般不用改；浏览器仍走 PORT）
# WEBSITE_PORT=11113
# CONSOLE_PORT=11114

# 调试安装向导（有上面两项时仍会进 /setup）
# CHUNSUN_FORCE_SETUP=1
